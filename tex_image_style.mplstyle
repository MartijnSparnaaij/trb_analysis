## ***************************************************************************
## * LaTeX                                                                   *
## ***************************************************************************

text.latex.preamble: [r"usepackage{lmodern}"]
text.usetex: True


## ***************************************************************************
## * FONT                                                                    *
## ***************************************************************************

font.family:  lmodern
font.style:   normal
font.variant: normal
font.weight:  normal
font.stretch: normal
font.size:    10.0

## ***************************************************************************
## * SIZES                                                                   *
## ***************************************************************************
xtick.labelsize: 9
ytick.labelsize: 9
axes.titlesize: 10
axes.labelsize: 10
legend.fontsize: 9
legend.title_fontsize: 10