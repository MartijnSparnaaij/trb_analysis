## ***************************************************************************
## * LaTeX                                                                   *
## ***************************************************************************

text.latex.preamble: [r"usepackage{lmodern}"]
text.usetex: True

## ***************************************************************************
## * FONT                                                                    *
## ***************************************************************************

font.family:  lmodern
font.style:   normal
font.variant: normal
font.weight:  normal
font.stretch: normal
font.size:    10.0

## ***************************************************************************
## * SIZES                                                                   *
## ***************************************************************************

xtick.labelsize: 9
ytick.labelsize: 9
axes.titlesize: 10
axes.labelsize: 10
legend.fontsize: 9
legend.title_fontsize: 10

## ***************************************************************************
## * BOXPLOT                                                                 *
## ***************************************************************************
boxplot.notch:       True
boxplot.vertical:    True
boxplot.patchartist: True

boxplot.flierprops.color:           0.2
boxplot.flierprops.marker:          x
boxplot.flierprops.markeredgecolor: 0.2
boxplot.flierprops.markeredgewidth: 1.0
boxplot.flierprops.markersize:      4
boxplot.flierprops.linestyle:       none
boxplot.flierprops.linewidth:       1.0

boxplot.boxprops.color:     black
boxplot.boxprops.linewidth: 1.5

boxplot.whiskerprops.linewidth: 1.5

boxplot.capprops.linewidth: 1.5

boxplot.medianprops.color:  tab:orange
boxplot.medianprops.linewidth: 1.5
